{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "lib": ["deno.window"]
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.45.4",
    "@std/assert": "jsr:@std/assert@1.0.9"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "include": ["_shared/", "outfits/"]
  },
  "lint": {
    "include": ["_shared/", "outfits/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "check": "deno check _shared/**/*.ts outfits/**/*.ts",
    "test": "deno test --allow-env _shared/ outfits/",
    "fmt-check": "deno fmt --check _shared/ outfits/",
    "lint": "deno lint _shared/ outfits/"
  }
}
