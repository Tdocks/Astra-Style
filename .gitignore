# === Xcode ===
# The .xcodeproj is generated by XcodeGen from ios/project.yml — see
# docs/adr/0008-xcodegen-project-generation.md. Do NOT ignore project.yml itself.
*.xcodeproj/
*.xcworkspace/
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
timeline.xctimeline
playground.xcworkspace
.build/

# CocoaPods (not the primary dependency manager, but ignore if ever introduced)
Pods/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# === Swift Package Manager ===
.swiftpm/
.build/
Package.resolved

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# === Astra secrets — never commit these ===
ios/Config/Secrets.xcconfig
.env
.env.*
!.env.example
**/*.pem
**/*.p8
**/*.p12
**/*.mobileprovision
supabase/.env
supabase/functions/**/.env

# === Supabase local artifacts ===
supabase/.branches/
supabase/.temp/
supabase/.env.local
.supabase/

# === Edge Functions (Deno/Node tooling) ===
supabase/functions/**/node_modules/
node_modules/
npm-debug.log*
yarn-error.log*
deno.lock

# === Generated / downloaded media (never commit user or provider-generated imagery) ===
**/GeneratedMedia/
**/StudioOutputs/
**/*.generated.png
**/*.generated.jpg
**/*.generated.heic
ios/AstraStyle/Resources/DownloadedAssets/

# === Test artifacts ===
*.xcresult
TestResults/
__snapshots__/**/*.actual.png
