// Secrets.example.xcconfig
//
// Template for the developer-local secrets file. Copy this file to
// "Secrets.xcconfig" in this same directory and fill in real values.
// Secrets.xcconfig is listed in .gitignore and must never be committed.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Per spec §25, ONLY these two values are permitted to ship inside the iOS
// client. Everything else (service role keys, provider API keys, webhook
// secrets) lives exclusively in Supabase Edge Function environment
// variables and must never appear here or anywhere in the app target.
//
// Remember the "//" comment footgun documented in Base.xcconfig: any URL
// value must break up its "//" with an empty macro reference "$()", e.g.
// "https:/$()/xyzcompany.supabase.co", or the value will be silently
// truncated at the first "//".

// The project ref URL for your Supabase project, e.g.
// https://xyzcompany.supabase.co (see Base.xcconfig for why "$()" appears
// below instead of a literal "//").
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co

// The Supabase "anon" public key (safe for client distribution; it is
// constrained entirely by Row Level Security). Do NOT use the service role
// key here under any circumstances.
SUPABASE_ANON_KEY = YOUR-ANON-PUBLIC-KEY
